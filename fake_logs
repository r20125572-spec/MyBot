"""
fake_logs.py — Owner-only fake CHARGED hit stream.

Drop this file next to your main.py, then add TWO lines to main.py:

    At the top (with other imports):
        import fake_logs

    Inside main(), after building `app` and before app.run_polling():
        fake_logs.register(app)

That is the ONLY change needed in main.py.
No changes to sh.py or database.py required.
"""

