# COMMAND HANDLERS  (all owner-only, completely silent to others)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

async def _cmd_fakeon(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """/fakeon — open the fake logs control panel (owner only, silent to others)."""
    if update.effective_user.id != OWNER_ID:
        return  # completely silent

    bd     = context.bot_data
    target = bd.get("fakelogs_channel_id", _CHANNEL_ID)
    if not target:
        await update.message.reply_text(
            "<b>⚠️ Log channel not configured!</b>\n"
            "──────────\n"
            "1. Add the bot as <b>admin</b> to your fake-log channel.\n"
            "2. Run <code>/getid</code> <i>inside that channel</i>.\n"
            "3. The ID is saved automatically — no redeploy needed.",
            parse_mode="HTML",
        )
        return

    await update.message.reply_text(
        _main_text(bd),
        parse_mode="HTML",
        reply_markup=_main_kb(bd),
    )


async def _cmd_fakeoff(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """/fakeoff — stop the stream (owner only, silent to others)."""
    if update.effective_user.id != OWNER_ID:
        return
    context.bot_data[_ACTIVE] = False
    _stop_job(context)
    await update.message.reply_text("<b>⛔ Fake logs stopped.</b>", parse_mode="HTML")


async def _cmd_getid(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """/getid — reply with the current chat's ID and save it as the fake-log channel.
    Run this command INSIDE the target channel to configure it without a redeploy."""
    if update.effective_user.id != OWNER_ID:
        return
    chat = update.effective_chat
    cid  = chat.id
    context.bot_data["fakelogs_channel_id"] = cid
    await update.message.reply_text(
        f"<b>📋 Chat ID: <code>{cid}</code></b>\n"
        f"<b>Title: {chat.title or 'DM'}</b>\n\n"
        f"Saved as fake-log channel. Use /fakeon to start.",
        parse_mode="HTML",
    )


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# MASTER CALLBACK HANDLER  (all fl_* / fltog_* / flrem_* / flspd_*)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

async def _cb(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    q = update.callback_query
    if q.from_user.id != OWNER_ID:
        await q.answer("⛔ Owner only.", show_alert=True)
        return
    await q.answer()

    bd  = context.bot_data
    dat = q.data

    # ── Main panel ────────────────────────────────────────────────────────────
    if dat == "fl_panel":
        await q.edit_message_text(
            _main_text(bd), parse_mode="HTML",
            reply_markup=_main_kb(bd),
        )

    elif dat == "fl_start":
        enabled = [e for e in _get_ids(bd) if e.get("enabled", True)]
        if not enabled:
            await q.answer("⚠️ Enable at least one ID first.", show_alert=True)
            return
        bd[_ACTIVE] = True
        _stop_job(context)
        context.job_queue.run_once(_job, 3, name=_JOB)
        await q.edit_message_text(
            _main_text(bd), parse_mode="HTML",
            reply_markup=_main_kb(bd),
        )

    elif dat == "fl_stop":
        bd[_ACTIVE] = False
        _stop_job(context)
        await q.edit_message_text(
            _main_text(bd), parse_mode="HTML",
            reply_markup=_main_kb(bd),
        )

    elif dat == "fl_noop":
        pass  # display-only button — intentional no-op

    # ── IDs panel ─────────────────────────────────────────────────────────────
    elif dat == "fl_ids":
        await q.edit_message_text(
            _ids_text(bd), parse_mode="HTML",
            reply_markup=_ids_kb(bd),
        )

    elif dat == "fl_addid":
        bd["fl_state"] = "awaiting_id"
        await q.edit_message_text(
            "<b>➕ Add Fake Log ID</b>\n──────────\n"
            "Send the user details in your next message:\n\n"
            "<b>Format:</b>  <code>123456789 @username</code>\n"
            "or just       <code>@username</code>\n\n"
            "<i>This display name will appear as the 'User' on every fake hit log.</i>\n"
            "──────────\nSend /fakeon to cancel.",
            parse_mode="HTML",
        )

    elif dat.startswith("fltog_"):
        try:
            idx = int(dat.split("_", 1)[1])
        except (ValueError, IndexError):
            return
        ids = _get_ids(bd)
        if 0 <= idx < len(ids):
            ids[idx]["enabled"] = not ids[idx].get("enabled", True)
        await q.edit_message_text(
            _ids_text(bd), parse_mode="HTML",
            reply_markup=_ids_kb(bd),
        )

    elif dat.startswith("flrem_"):
        try:
            idx = int(dat.split("_", 1)[1])
        except (ValueError, IndexError):
            return
        ids = _get_ids(bd)
        if 0 <= idx < len(ids):
            ids.pop(idx)
        await q.edit_message_text(
            _ids_text(bd), parse_mode="HTML",
            reply_markup=_ids_kb(bd),
        )

    # ── Speed panel ───────────────────────────────────────────────────────────
    elif dat == "fl_speed":
        await q.edit_message_text(
            _speed_text(), parse_mode="HTML",
            reply_markup=_speed_kb(bd),
        )

    elif dat.startswith("flspd_"):
        spd = dat.split("_", 1)[1]
        if spd in _SPEEDS:
            bd["fl_speed"] = spd
        await q.edit_message_text(
            _speed_text(), parse_mode="HTML",
            reply_markup=_speed_kb(bd),
        )

    # ── Stats panel ───────────────────────────────────────────────────────────
    elif dat == "fl_show":
        await q.edit_message_text(
            _show_text(bd), parse_mode="HTML",
            reply_markup=_show_kb(),
        )

    elif dat == "fl_clrstats":
        for e in _get_ids(bd):
            e["count"] = 0
        await q.edit_message_text(
            _show_text(bd), parse_mode="HTML",
            reply_markup=_show_kb(),
        )


