def _get_ids(bd: dict) -> list:
    return bd.setdefault("fl_ids", [])


def _get_speed(bd: dict) -> str:
    return bd.get("fl_speed", "normal")


def _stop_job(context: ContextTypes.DEFAULT_TYPE) -> None:
    for job in context.job_queue.get_jobs_by_name(_JOB):
        job.schedule_removal()


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# FAKE LOG MESSAGE BUILDER
# Produces a message identical to the real hit log in sh.py.
# Format:
#   HIT → CHARGED 💎
#   Gate → Shopify • X.XX USD
#   ✅ ORDER_PAID
#   User → @username ⭐
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

def _build_log_msg(id_entry: dict) -> str:
    price = random.choice(_PRICES)
    eid   = _rand_charged_eid()
    ulink = f'<a href="{id_entry["link"]}">{id_entry["display"]}</a>'
    return (
        f'<b>HIT ➛ CHARGED '
        f'<tg-emoji emoji-id="{eid}">💎</tg-emoji></b>\n'
        f'<b>Gate ➛ Shopify • {price} USD</b>\n'
        f'<b><tg-emoji emoji-id="{_HIT_RESP_EID}">✅</tg-emoji>'
        f' <code>ORDER_PAID</code></b>\n'
        f'<b>User ➛ {ulink}'
        f' <tg-emoji emoji-id="{_PRO_EID}">⭐</tg-emoji></b>'
    )


def _build_button() -> InlineKeyboardMarkup:
    return InlineKeyboardMarkup([[
        InlineKeyboardButton("𝘽𝘼𝙏 ✘ 𝘾𝙃𝙆", url=_BOT_URL)
    ]])


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# BACKGROUND JOB — fires one fake log then reschedules itself
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

async def _job(context: ContextTypes.DEFAULT_TYPE) -> None:
    bd = context.bot_data

    if not bd.get(_ACTIVE):
        return

    target = bd.get("fakelogs_channel_id", _CHANNEL_ID)
    if not target:
        logger.warning("[FAKELOGS] No channel ID set — stopping.")
        bd[_ACTIVE] = False
        return

    ids = [e for e in _get_ids(bd) if e.get("enabled", True)]
    lo, hi = _SPEEDS[_get_speed(bd)]

    if ids:
        entry = random.choice(ids)
        text  = _build_log_msg(entry)
        try:
            await context.bot.send_message(
                target, text,
                parse_mode="HTML",
                reply_markup=_build_button(),
                disable_web_page_preview=True,
            )
            # ── per-ID hit counter ────────────────────────────────────────
            entry["count"] = entry.get("count", 0) + 1

            # ── propagate into total_charged so /me & /status reflect it ─
            # Works only when the fake-log entry has a numeric Telegram UID
            # AND that user has previously started the bot (in user_data).
            uid_str = str(entry.get("uid", ""))
            if uid_str and uid_str.lstrip("-").isdigit():
                ud_store = bd.setdefault("user_data", {})
                if uid_str in ud_store:
                    ud_store[uid_str]["total_charged"] = (
                        ud_store[uid_str].get("total_charged", 0) + 1
                    )
        except Exception as exc:
            logger.warning(f"[FAKELOGS] send failed (chat={target}): {exc}")

    if bd.get(_ACTIVE):
        context.job_queue.run_once(_job, random.uniform(lo, hi), name=_JOB)


